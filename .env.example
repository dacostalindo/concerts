# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (needs 2-step verification). The same login is used for SMTP (sending) and
# IMAP (reading your "Remind me" mails).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
MAIL_TO=you@gmail.com
# MAIL_FROM=you@gmail.com            # defaults to SMTP_USER
# WATCH_ALLOWED_FROM=you@gmail.com   # who may add shows to the watchlist (comma-separated); defaults to MAIL_TO
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# IMAP_HOST=imap.gmail.com

# Optional: direct Spotify album links (otherwise Spotify search links).
# Create an app at https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# How far back to look for reviews.
# LOOKBACK_DAYS=21

# Concertje MCP. The search tool is picked automatically; override it if
# `concert-digest tools` shows a better one.
# CONCERTJE_MCP_URL=https://ai.concertje.be/mcp
# CONCERTJE_SEARCH_TOOL=
# CONCERTJE_SEARCH_ARG=
# CONCERTJE_OAUTH_PORT=8765

# Where tokens and state live (default ~/.concert-digest).
# CONCERT_DIGEST_HOME=
