# Bearer token Grok sends (xAI `authorization` field). Required when HOST isn't localhost.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Public HTTPS address of this server (your tunnel or host), used in preview links.
PUBLIC_BASE_URL=https://concert-digest.example.com

# Optional: only accept requests for these Host headers (comma-separated).
# MCP_ALLOWED_HOSTS=concert-digest.example.com

# HOST=0.0.0.0
# PORT=8000

# Where rendered emails are stored (default ~/.concert-digest/renders).
# RENDER_DIR=

# Optional: direct Spotify album links (otherwise Spotify search links).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
